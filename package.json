{
  "name": "@calmessimple/mcp-bling",
  "version": "0.3.0",
  "description": "MCP server for Bling ERP — orders, products, invoices, stock, AR/AP, webhooks. Fork of @codespar/mcp-bling with additional tools.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mcp-bling": "./dist/index.js"
  },
  "scripts": {
