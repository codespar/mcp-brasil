    "start": "node dist/index.js",
    "start:http": "MCP_HTTP=true node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "bling",
    "erp",
    "invoices",
    "stock",
    "brazil",
