{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.codespar/mcp-clip",
  "description": "MCP server for Clip (PayClip) — Mexico's leading acquirer: payment links, card charges, refunds",
  "repository": {
    "url": "https://github.com/codespar/mcp-dev-latam",
    "source": "github",
    "subfolder": "packages/mexico/clip"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@codespar/mcp-clip",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CLIP_AUTH_TOKEN",
          "description": "Basic auth token from the Clip developer dashboard",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "CLIP_BASE_URL",
          "description": "API base URL override. Defaults to https://api.payclip.com.",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ],
  "provider": {
    "homepage": "https://clip.mx",
    "logoUrl": "https://logo.clearbit.com/clip.mx",
    "logoFallback": "https://www.google.com/s2/favicons?domain=clip.mx&sz=128",
    "docsUrl": "https://developer.clip.mx",
    "sandbox": {
      "available": true
    }
  }
}
